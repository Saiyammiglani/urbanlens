ml/datasets/kaggle/roaddamage/
ml/datasets/kaggle/garbage/
ml/datasets/kaggle/crack_neg/
dashboard/.env

# ANPR training data (multi-MB, Kaggle download)
ml/anpr_data/
ml/dataset_anpr/
