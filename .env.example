# Database (leave unset to use local SQLite file)
DATABASE_URL=
# Production (Supabase): Project Settings -> Database -> Connection string -> URI
# Use the SESSION pooler (port 5432) for the backend, e.g.
# DATABASE_URL=postgresql+psycopg://postgres.abcdefghij:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# MQTT (leave unset to disable MQTT transport)
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=urbanlens/ingest

# Set to 1 to run the MQTT worker inside the backend process
RUN_MQTT_WORKER=0

# Simple bearer token protecting write endpoints (demo-grade)
API_TOKEN=sih-demo-token

# Edge agent settings
EDGE_BACKEND_URL=http://localhost:8000
EDGE_MODEL_PATH=edge/models/model.onnx
EDGE_CONF_THRESHOLD=0.45
EDGE_GPS_SERIAL=            # e.g. COM4 or /dev/ttyUSB0; empty = replay mode
# KAGGLE_API_TOKEN=  (optional: dataset sourcing for v3 training)

# External data APIs (free tiers)
# OpenAQ (https://explore.openaq.org/account) — fallback AQI source
OPENAQ_API_KEY=
# data.gov.in (https://data.gov.in) — CPCB real-time AQI, primary source
DATAGOV_API_KEY=

# --- Supabase Realtime (instant dashboard pings; optional - polling works without it) ---
# From Supabase dashboard -> Project Settings -> API:
VITE_SUPABASE_URL=https://fkbpaaopnrprgugjtnle.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key
